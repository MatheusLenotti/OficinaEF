@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}

<style>
    /* ==========================================================================
       Tema Glassmorphism - Registro
       ========================================================================== */
    body {
        background: linear-gradient(-45deg, #000000, #3A5228, #570C13, #1a060a);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: #DFDEE0;
        min-height: 100vh;
    }

    @@keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* Container Principal (Card de Vidro) */
    .row {
        background: rgba(30, 30, 30, 0.35); 
        backdrop-filter: blur(20px); 
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1); 
        border-radius: 24px;
        padding: 3rem;
        margin-top: 2rem;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4); 
    }

    h1 {
        text-align: center;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.5px;
    }

    h2, h3 {
        font-size: 1.25rem;
        font-weight: 500;
        color: #ffffff;
    }

    hr { border-color: rgba(255, 255, 255, 0.15); }

    p a, a {
        color: #AC9CA5;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

    p a:hover, a:hover { color: #DFDEE0; }

    /* Inputs translúcidos */
    .form-floating > .form-control {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .form-floating > .form-control:focus {
        background: rgba(255, 255, 255, 0.1);
        border-color: #C32116;
        box-shadow: 0 0 0 0.25rem rgba(195, 33, 22, 0.25);
        color: #ffffff;
    }

    .form-floating > label { color: #AC9CA5; }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #DFDEE0;
        transform: scale(0.85) translateY(-0.75rem) translateX(0.15rem);
    }

    /* Botão Principal */
    .btn-primary {
        background: linear-gradient(90deg, #C32116, #570C13);
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 0.85rem;
        color: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(195, 33, 22, 0.4);
        background: linear-gradient(90deg, #e3261a, #75101a);
    }

    /* Botões de Registro Externo */
    #external-account .btn {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        color: #DFDEE0;
        width: 100%;
        margin-bottom: 0.75rem;
        padding: 0.75rem;
        font-weight: 500;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.3s ease;
    }

    #external-account .btn:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-1px);
    }
</style>

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Criar uma nova conta.</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                <label asp-for="Input.Email">E-mail</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                <label asp-for="Input.Password">Senha</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                <label asp-for="Input.ConfirmPassword">Confirmar senha</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Cadastrar</button>
        </form>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>Registrar usando outro serviço.</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            Não há serviços de autenticação externa configurados. Veja este <a href="https://go.microsoft.com/fwlink/?LinkID=532715">artigo
                            sobre como configurar esta aplicação ASP.NET para suporte a login externo</a>.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Entrar usando sua conta @provider.DisplayName">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}